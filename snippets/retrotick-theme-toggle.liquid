{% doc %}
  Retrotick Dark / Light Mode Toggle Switch
  Persists user preference to localStorage and updates [data-theme]
{% enddoc %}

<div class="rt-theme-toggle-wrapper" data-testid="retrotick-theme-toggle">
  <button
    type="button"
    class="rt-theme-toggle-btn"
    id="RtThemeToggleBtn"
    aria-label="Toggle Dark / Light Mode"
    title="Toggle Dark / Light Mode"
  >
    <span class="rt-toggle-icon rt-toggle-icon--moon" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </span>
    <span class="rt-toggle-slider">
      <span class="rt-toggle-knob"></span>
    </span>
    <span class="rt-toggle-icon rt-toggle-icon--sun" aria-hidden="true">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </span>
    <span class="rt-toggle-label" id="RtToggleLabel">Dark</span>
  </button>
</div>

<script>
  (function() {
    function initThemeToggle() {
      var btn = document.getElementById('RtThemeToggleBtn');
      var label = document.getElementById('RtToggleLabel');
      if (!btn) return;

      function updateLabel(theme) {
        if (label) {
          label.textContent = theme === 'light' ? 'Light' : 'Dark';
        }
      }

      var current = document.documentElement.getAttribute('data-theme') || 'dark';
      updateLabel(current);

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
        var newTheme = currentTheme === 'light' ? 'dark' : 'light';

        document.documentElement.setAttribute('data-theme', newTheme);
        try {
          localStorage.setItem('retrotick_theme', newTheme);
        } catch (err) {}
        updateLabel(newTheme);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initThemeToggle);
    } else {
      initThemeToggle();
    }
  })();
</script>
