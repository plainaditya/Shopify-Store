{%- liquid
  assign current_prod = closest.product | default: product | default: section.settings.product | default: collections.all.products.first
  assign prod_price = current_prod.price | default: 99900 | money_without_trailing_zeros
  assign compare_price = current_prod.compare_at_price | money_without_trailing_zeros
-%}

<div class="rt-sticky-bar" id="RtStickyBar" aria-hidden="true">
  <div class="rt-sticky-inner">
    <div class="rt-sticky-prod">
      {%- if current_prod.featured_image != blank -%}
        <img
          class="rt-sticky-thumb"
          src="{{ current_prod.featured_image | image_url: width: 90, height: 90, crop: 'center' }}"
          alt="{{ current_prod.title | escape }}"
          loading="lazy"
        >
      {%- else -%}
        <img
          class="rt-sticky-thumb"
          src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=120&q=80"
          alt=""
          loading="lazy"
        >
      {%- endif -%}
      <div>
        <p class="rt-sticky-title">{{ current_prod.title | default: "Casio Vintage A168W Steel" }}</p>
        <p class="rt-sticky-price">
          <strong style="font-size: 1rem;">{{ prod_price }}</strong>
          {%- if current_prod.compare_at_price > current_prod.price -%}
            <span style="text-decoration: line-through; opacity: 0.6; margin: 0 6px;">{{ compare_price }}</span>
            <span class="rt-discount-pill" style="padding: 2px 7px; font-size: 0.68rem;">SALE</span>
          {%- else -%}
            <span style="text-decoration: line-through; opacity: 0.6; margin: 0 6px;">₹1,999</span>
            <span class="rt-discount-pill" style="padding: 2px 7px; font-size: 0.68rem;">50% OFF</span>
          {%- endif -%}
        </p>
      </div>
    </div>

    <div>
      <a href="#TheWatch" class="rt-sticky-btn" id="RtStickyBtn">
        Order Now – {{ prod_price }} (COD)
      </a>
    </div>
  </div>
</div>

<script>
  (function() {
    function initStickyBar() {
      const stickyBar = document.getElementById('RtStickyBar');
      const heroSection = document.getElementById('TheWatch') || document.querySelector('.product-information') || document.querySelector('.product-details');

      if (!stickyBar || !heroSection) return;

      const btn = document.getElementById('RtStickyBtn');
      if (btn && !document.getElementById('TheWatch')) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const target = document.querySelector('form[action*="/cart/add"] button[type="submit"]') || document.querySelector('.product-details') || document.querySelector('.product-information');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            if (target.tagName === 'BUTTON' && !target.disabled) {
              target.focus();
            }
          }
        });
      }

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
              stickyBar.classList.add('visible');
              stickyBar.setAttribute('aria-hidden', 'false');
            } else {
              stickyBar.classList.remove('visible');
              stickyBar.setAttribute('aria-hidden', 'true');
            }
          });
        }, { threshold: [0], rootMargin: '-60px 0px 0px 0px' });
        observer.observe(heroSection);
      } else {
        let ticking = false;
        window.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(function() {
              const heroBottom = heroSection.getBoundingClientRect().bottom;
              if (heroBottom < 100) {
                stickyBar.classList.add('visible');
                stickyBar.setAttribute('aria-hidden', 'false');
              } else {
                stickyBar.classList.remove('visible');
                stickyBar.setAttribute('aria-hidden', 'true');
              }
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyBar);
    } else {
      initStickyBar();
    }
  })();
</script>

{% schema %}
{
  "name": "Retrotick Sticky Bar",
  "settings": [],
  "presets": [
    {
      "name": "Retrotick Sticky Bar"
    }
  ]
}
{% endschema %}
