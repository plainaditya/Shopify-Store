{%- liquid
  assign current_prod = closest.product | default: product | default: section.settings.product | default: collections.all.products.first
  assign prod_price = current_prod.price | default: 99900 | money_without_trailing_zeros
  assign compare_price = current_prod.compare_at_price | money_without_trailing_zeros
-%}

<div class="rt-sticky-bar" id="RtStickyBar" aria-hidden="true">
  <div class="rt-sticky-inner">
    <div class="rt-sticky-prod">
      <div class="rt-sticky-thumb-card">
        {%- if current_prod.featured_image != blank -%}
          <img
            class="rt-sticky-thumb"
            src="{{ current_prod.featured_image | image_url: width: 140, height: 140, crop: 'center' }}"
            alt="{{ current_prod.title | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <img
            class="rt-sticky-thumb"
            src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=140&q=80"
            alt="{{ current_prod.title | escape }}"
            loading="lazy"
          >
        {%- endif -%}
      </div>
      <div class="rt-sticky-info">
        <p class="rt-sticky-title">{{ current_prod.title | default: "Casio Vintage A168W Steel" }}</p>
        <p class="rt-sticky-price">
          <strong class="rt-sticky-main-price">{{ prod_price }}</strong>
          {%- if current_prod.compare_at_price > current_prod.price -%}
            <span class="rt-sticky-cut-price">{{ compare_price }}</span>
            <span class="rt-sticky-discount-pill">SALE</span>
          {%- else -%}
            <span class="rt-sticky-cut-price">₹1,999</span>
            <span class="rt-sticky-discount-pill">50% OFF</span>
          {%- endif -%}
        </p>
      </div>
    </div>

    <div class="rt-sticky-action">
      <a href="#TheWatch" class="rt-sticky-btn" id="RtStickyBtn">
        <span class="rt-sticky-btn-text-desktop">ORDER NOW – {{ prod_price }} (COD) ➔</span>
        <span class="rt-sticky-btn-text-mobile">ORDER NOW ➔</span>
      </a>
    </div>
  </div>
</div>

<script>
  (function() {
    function initStickyBar() {
      const stickyBar = document.getElementById('RtStickyBar');
      const heroSection = document.getElementById('TheWatch') || document.querySelector('.product-information') || document.querySelector('.product-details');

      if (!stickyBar || !heroSection) return;

      const btn = document.getElementById('RtStickyBtn');
      if (btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const target = document.querySelector('.rt-btn-buy-now') || document.querySelector('form[action*="/cart/add"] button[type="submit"]') || document.getElementById('TheWatch') || document.querySelector('.product-details');
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            if (target.tagName === 'BUTTON' && !target.disabled) {
              target.focus();
            }
          }
        });
      }

      function isCartOpen() {
        const cartDrawer = document.getElementById('cart-drawer');
        if (cartDrawer && cartDrawer.hasAttribute('open')) return true;
        if (document.querySelector('dialog.theme-drawer__dialog[open]')) return true;
        return false;
      }

      function updateVisibility(entries) {
        if (isCartOpen()) {
          stickyBar.classList.remove('visible');
          stickyBar.setAttribute('aria-hidden', 'true');
          return;
        }

        if (entries) {
          entries.forEach(function(entry) {
            if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
              stickyBar.classList.add('visible');
              stickyBar.setAttribute('aria-hidden', 'false');
            } else {
              stickyBar.classList.remove('visible');
              stickyBar.setAttribute('aria-hidden', 'true');
            }
          });
        }
      }

      // Hide sticky bar when cart drawer is opened
      document.addEventListener('theme-drawer:open', function() {
        stickyBar.classList.remove('visible');
        stickyBar.setAttribute('aria-hidden', 'true');
      });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(updateVisibility, { threshold: [0], rootMargin: '-60px 0px 0px 0px' });
        observer.observe(heroSection);
      } else {
        let ticking = false;
        window.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(function() {
              if (isCartOpen()) {
                stickyBar.classList.remove('visible');
                stickyBar.setAttribute('aria-hidden', 'true');
              } else {
                const heroBottom = heroSection.getBoundingClientRect().bottom;
                if (heroBottom < 100) {
                  stickyBar.classList.add('visible');
                  stickyBar.setAttribute('aria-hidden', 'false');
                } else {
                  stickyBar.classList.remove('visible');
                  stickyBar.setAttribute('aria-hidden', 'true');
                }
              }
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyBar);
    } else {
      initStickyBar();
    }
  })();
</script>

{% schema %}
{
  "name": "Retrotick Sticky Bar",
  "settings": [],
  "presets": [
    {
      "name": "Retrotick Sticky Bar"
    }
  ]
}
{% endschema %}
