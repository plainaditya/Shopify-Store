<section class="rt-specs-section" id="Specifications">
  <div class="rt-section-header">
    <span class="rt-section-badge">PRECISION BENCHMARK</span>
    <h2 class="rt-section-title">Technical Specifications</h2>
    <p class="rt-section-sub">
      Every detail engineered to Casio's legendary Japanese reliability standards.
    </p>
  </div>

  <div class="rt-specs-table-wrap">
    <div class="rt-specs-row">
      <div class="rt-specs-label">Model / Series</div>
      <div class="rt-specs-value">Casio Vintage Unisex Steel (A168WA Series)</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Movement</div>
      <div class="rt-specs-value">Japanese Digital Quartz Module (Accuracy: ±30 sec / month)</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Dimensions</div>
      <div class="rt-specs-value">38.6 × 36.3 × 9.6 mm (Ultra-compact unisex profile)</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Total Weight</div>
      <div class="rt-specs-value">49 grams (Featherlight all-day comfort)</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Case & Bezel Material</div>
      <div class="rt-specs-value">Chrome Plated Resin Body with Solid Stainless Steel Caseback</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Band & Clasp</div>
      <div class="rt-specs-value">Brushed 316L Stainless Steel with Self-Adjusting Fold-Over Clasp</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Glass</div>
      <div class="rt-specs-value">Impact-Resistant Spherical Resin Crystal</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Water Resistance</div>
      <div class="rt-specs-value">30 Meters / 3 ATM (Splash, rain, & hand-wash resistant)</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Illumination</div>
      <div class="rt-specs-value">ElectroLuminescent (EL) Panel with Signature Cyan-Blue Glow</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Core Functions</div>
      <div class="rt-specs-value">1/100-Sec Stopwatch, Daily Alarm, Hourly Chime, Auto-Calendar</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Power & Battery Life</div>
      <div class="rt-specs-value">CR2016 Lithium Battery — Approx. 7 Years Operating Life</div>
    </div>
    <div class="rt-specs-row">
      <div class="rt-specs-label">Package Inclusions</div>
      <div class="rt-specs-value">Original Casio Vintage Presentation Box, User Manual, Official Warranty Card</div>
    </div>
  </div>
</section>

