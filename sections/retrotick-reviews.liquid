<section class="rt-reviews-section" id="Reviews">
  <div class="rt-section-header">
    <span class="rt-section-badge">COMMUNITY & SOCIAL PROOF</span>
    <h2 class="rt-section-title">Verified Watch Owners</h2>
    <p class="rt-section-sub">
      Over 1,480+ happy collectors, creators, and everyday wearers across India.
    </p>
  </div>

  <div class="rt-reviews-grid">
    <div class="rt-review-card">
      <div>
        <div class="rt-review-stars">★★★★★</div>
        <p class="rt-review-text">
          "Hands down the best accessory I've bought this year. The steel bracelet has this crisp brushed texture that looks way more expensive than it is. The EL backlight in the dark is unreal!"
        </p>
      </div>
      <div class="rt-review-author">
        <div>
          <div class="rt-author-name">Arjun M.</div>
          <div class="rt-author-location">Bandra, Mumbai</div>
        </div>
        <span class="rt-verified-tag">✓ Verified Buyer</span>
      </div>
    </div>

    <div class="rt-review-card">
      <div>
        <div class="rt-review-stars">★★★★★</div>
        <p class="rt-review-text">
          "I was worried about the clasp fitting my thin wrist, but it literally takes 5 seconds to adjust by sliding the lock. Got tons of compliments at work. 100% authentic packaging as well."
        </p>
      </div>
      <div class="rt-review-author">
        <div>
          <div class="rt-author-name">Pooja S.</div>
          <div class="rt-author-location">Indiranagar, Bangalore</div>
        </div>
        <span class="rt-verified-tag">✓ Verified Buyer</span>
      </div>
    </div>

    <div class="rt-review-card">
      <div>
        <div class="rt-review-stars">★★★★★</div>
        <p class="rt-review-text">
          "Delivered in just 2 days to South Delhi via COD. The watch is featherlight, timeless, and literally indestructible. If you're into minimal retro style, this is the Holy Grail."
        </p>
      </div>
      <div class="rt-review-author">
        <div>
          <div class="rt-author-name">Karan V.</div>
          <div class="rt-author-location">Hauz Khas, New Delhi</div>
        </div>
        <span class="rt-verified-tag">✓ Verified Buyer</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Retrotick Reviews",
  "settings": [],
  "presets": [
    {
      "name": "Retrotick Reviews"
    }
  ]
}
{% endschema %}
