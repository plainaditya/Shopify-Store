{%- liquid
  assign product = section.settings.product | default: collections.all.products.first
  assign current_variant = product.selected_or_first_available_variant
  assign main_img = product.featured_image
-%}

<section class="rt-product-section" id="TheWatch">
  <div class="rt-product-container">
    <!-- Gallery Carousel Showcase -->
    <div class="rt-gallery" id="RtGalleryWrapper">
      <div class="rt-gallery-stage">
        <!-- Floating Live Badge -->
        <div class="rt-stage-badge">
          <span class="rt-badge-pulse"></span>
          <span>100% Original Casio Quartz</span>
        </div>

        <!-- Slides Container (Crossfade Architecture) -->
        <div class="rt-slides-viewport" id="RtSlidesViewport">
          <!-- Slide 0: Front Dial View -->
          <div class="rt-slide-panel active" data-slide="0">
            <div class="rt-img-frame">
              {%- if main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 900 }}"
                  alt="{{ product.title | escape }} - Dial View"
                  class="rt-stage-img"
                  loading="eager"
                  width="600"
                  height="600"
                >
              {%- else -%}
                <img
                  src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=900&q=80"
                  alt="Casio Vintage Stainless Steel Watch"
                  class="rt-stage-img"
                  loading="eager"
                  width="600"
                  height="600"
                >
              {%- endif -%}
            </div>
            <div class="rt-slide-caption">VIEW 01 // FRONT DIAL</div>
          </div>

          <!-- Slide 1: Dial & Casing Close-Up -->
          <div class="rt-slide-panel" data-slide="1">
            <div class="rt-img-frame rt-frame-zoom">
              {%- if product.images.size > 1 -%}
                <img
                  src="{{ product.images[1] | image_url: width: 900 }}"
                  alt="Casio Dial Close Up"
                  class="rt-stage-img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- elsif main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 900 }}"
                  alt="Casio Dial Detail"
                  class="rt-stage-img rt-img-macro"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- else -%}
                <img
                  src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=900&q=80"
                  alt="Casio Vintage Close Up"
                  class="rt-stage-img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- endif -%}
            </div>
            <div class="rt-slide-caption">VIEW 02 // MACRO DETAIL</div>
          </div>

          <!-- Slide 2: Stainless Steel Bracelet View -->
          <div class="rt-slide-panel" data-slide="2">
            <div class="rt-img-frame rt-frame-bracelet">
              {%- if product.images.size > 2 -%}
                <img
                  src="{{ product.images[2] | image_url: width: 900 }}"
                  alt="Casio Steel Bracelet"
                  class="rt-stage-img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- elsif main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 900 }}"
                  alt="Casio Steel Links"
                  class="rt-stage-img rt-img-angle"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- else -%}
                <img
                  src="https://images.unsplash.com/photo-1542496658-e33a6d0d50f6?auto=format&fit=crop&w=900&q=80"
                  alt="Casio Steel Links"
                  class="rt-stage-img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- endif -%}
            </div>
            <div class="rt-slide-caption">VIEW 03 // 316L STEEL BRACELET</div>
          </div>

          <!-- Slide 3: Cyan EL Backlight Night Glow View -->
          <div class="rt-slide-panel rt-slide-night" data-slide="3">
            <div class="rt-img-frame rt-frame-glow">
              {%- if product.images.size > 3 -%}
                <img
                  src="{{ product.images[3] | image_url: width: 900 }}"
                  alt="Casio EL Backlight Glow"
                  class="rt-stage-img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- elsif main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 900 }}"
                  alt="Casio Night Glow"
                  class="rt-stage-img rt-img-night-glow"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- else -%}
                <img
                  src="https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?auto=format&fit=crop&w=900&q=80"
                  alt="Casio Night Backlight"
                  class="rt-stage-img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- endif -%}
              <div class="rt-el-glow-overlay"></div>
            </div>
            <div class="rt-slide-caption rt-caption-glow">VIEW 04 // EL ILLUMINATOR NIGHT GLOW</div>
          </div>
        </div>

        <!-- Carousel Navigation Arrows -->
        <button type="button" class="rt-nav-arrow rt-nav-prev" id="RtNavPrev" aria-label="Previous View">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="rt-nav-arrow rt-nav-next" id="RtNavNext" aria-label="Next View">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        <!-- Progress Indicator Dots -->
        <div class="rt-progress-dots" id="RtProgressDots">
          <button type="button" class="rt-dot-bar active" data-index="0" aria-label="View 1"></button>
          <button type="button" class="rt-dot-bar" data-index="1" aria-label="View 2"></button>
          <button type="button" class="rt-dot-bar" data-index="2" aria-label="View 3"></button>
          <button type="button" class="rt-dot-bar" data-index="3" aria-label="View 4"></button>
        </div>
      </div>

      <!-- Visible Visual Thumbnails Row with Image Previews -->
      <div class="rt-thumb-gallery" id="RtThumbGallery">
        <button type="button" class="rt-thumb-card active" data-slide-target="0">
          <div class="rt-thumb-preview">
            {%- if main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Dial">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=120&q=80" alt="Dial">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">Dial</span>
        </button>

        <button type="button" class="rt-thumb-card" data-slide-target="1">
          <div class="rt-thumb-preview">
            {%- if product.images.size > 1 -%}
              <img src="{{ product.images[1] | image_url: width: 140, height: 140, crop: 'center' }}" alt="Close Up">
            {%- elsif main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Close Up" style="transform: scale(1.4);">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=120&q=80" alt="Close Up">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">Close-Up</span>
        </button>

        <button type="button" class="rt-thumb-card" data-slide-target="2">
          <div class="rt-thumb-preview">
            {%- if product.images.size > 2 -%}
              <img src="{{ product.images[2] | image_url: width: 140, height: 140, crop: 'center' }}" alt="Steel">
            {%- elsif main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Steel" style="transform: rotate(20deg);">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1542496658-e33a6d0d50f6?auto=format&fit=crop&w=120&q=80" alt="Steel">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">Steel Band</span>
        </button>

        <button type="button" class="rt-thumb-card rt-thumb-card-glow" data-slide-target="3">
          <div class="rt-thumb-preview">
            {%- if product.images.size > 3 -%}
              <img src="{{ product.images[3] | image_url: width: 140, height: 140, crop: 'center' }}" alt="Night Glow">
            {%- elsif main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Night Glow" style="filter: drop-shadow(0 0 8px #00f0ff);">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?auto=format&fit=crop&w=120&q=80" alt="Night Glow">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">EL Glow 💡</span>
        </button>
      </div>

      <!-- Quick Backlight Glow Simulator Pill -->
      <button type="button" class="rt-glow-simulator-btn" id="RtGlowSimulatorBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>Click to test EL Night Backlight</span>
      </button>
    </div>

    <!-- Info / Conversion Engine Side -->
    <div class="rt-info">
      <!-- Live Inventory & Urgency Header -->
      <div class="rt-stock-alert">
        <span class="rt-pulse-live"></span>
        <span>HIGH DEMAND: ONLY 7 UNITS LEFT AT ₹999</span>
      </div>

      <div class="rt-product-header">
        <span class="rt-category-tag">RETRO HERITAGE SERIES // UNISEX</span>
        <h1 class="rt-product-title">
          {{ section.settings.title | default: product.title | default: "Casio Vintage Unisex Stainless Steel Watch" }}
        </h1>
        <p class="rt-product-subtitle">
          {{ section.settings.subtitle | default: "The definitive 1980s retro icon. Engineered in surgical-grade stainless steel with 30M water-resistance, 7-year battery, and signature cyan ElectroLuminescence backlight." }}
        </p>
      </div>

      <!-- Social Proof Rating -->
      <div class="rt-rating-row">
        <div class="rt-stars">★★★★★</div>
        <span class="rt-rating-score">4.9 / 5.0</span>
        <span class="rt-review-count">(1,480+ Verified Indian Buyers)</span>
        <span class="rt-badge-bestseller">#1 BEST SELLER</span>
      </div>

      <!-- High-Converting Price Card -->
      <div class="rt-price-box">
        <div class="rt-price-row">
          <div class="rt-price-main">
            <span class="rt-currency">₹</span><span class="rt-amount">999</span><span class="rt-decimals">.00</span>
          </div>
          <div class="rt-price-compare">
            <span class="rt-cut-price">₹1,999.00</span>
            <span class="rt-discount-pill">50% OFF</span>
          </div>
        </div>

        <!-- Stock Progress Bar -->
        <div class="rt-stock-progress-wrap">
          <div class="rt-progress-bar">
            <div class="rt-progress-fill" style="width: 82%;"></div>
          </div>
          <div class="rt-progress-labels">
            <span>Sold: 1,480 items</span>
            <span class="rt-urgent-text">🔥 Almost Gone!</span>
          </div>
        </div>

        <div class="rt-deal-perks">
          <span>✓ Free Express Shipping</span>
          <span>•</span>
          <span>✓ Cash On Delivery Available</span>
          <span>•</span>
          <span>✓ All Taxes Included</span>
        </div>
      </div>

      <!-- Purchase Actions -->
      {%- if product != blank -%}
        {%- form 'product', product, id: 'RtProductForm' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="RtVariantId">
          <input type="hidden" name="quantity" value="1">

          <div class="rt-actions-wrap">
            <button type="submit" class="rt-btn-buy-now" name="add" data-buy-now="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>ORDER NOW — ₹999 (CASH ON DELIVERY)</span>
            </button>
            <button type="submit" class="rt-btn-add-cart" name="add">
              <span>Add to Cart</span>
            </button>
          </div>
        {%- endform -%}
      {%- else -%}
        <div class="rt-actions-wrap">
          <a href="/cart" class="rt-btn-buy-now">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>ORDER NOW — ₹999 (CASH ON DELIVERY)</span>
          </a>
        </div>
      {%- endif -%}

      <!-- Fast Delivery & Pincode Reassurance -->
      <div class="rt-delivery-pills">
        <div class="rt-delivery-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <div>
            <strong>Dispatches Under 24 Hours</strong>
            <p>Fast track delivery via BlueDart / Delhivery</p>
          </div>
        </div>
        <div class="rt-delivery-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
          <div>
            <strong>30-Day Hassle-Free Returns</strong>
            <p>100% money back or direct replacement</p>
          </div>
        </div>
      </div>

      <!-- Trust Pillars -->
      <div class="rt-trust-mini-grid">
        <div class="rt-trust-chip">
          <span>🛡️</span> 100% Genuine Casio
        </div>
        <div class="rt-trust-chip">
          <span>⚙️</span> Japanese Quartz
        </div>
        <div class="rt-trust-chip">
          <span>💧</span> 30M Water Resistant
        </div>
        <div class="rt-trust-chip">
          <span>🔋</span> 7-Year Battery Life
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Rock-Solid 5-Second Carousel & Glow Simulator JavaScript -->
<script>
  (function() {
    function initGallery() {
      var slides = document.querySelectorAll('#RtSlidesViewport .rt-slide-panel');
      var dots = document.querySelectorAll('#RtProgressDots .rt-dot-bar');
      var thumbs = document.querySelectorAll('#RtThumbGallery .rt-thumb-card');
      var prevBtn = document.getElementById('RtNavPrev');
      var nextBtn = document.getElementById('RtNavNext');
      var glowBtn = document.getElementById('RtGlowSimulatorBtn');
      var wrapper = document.getElementById('RtGalleryWrapper');

      if (!slides.length) return;

      var currentSlide = 0;
      var totalSlides = slides.length;
      var slideInterval = null;
      var intervalDuration = 5000; // 5 seconds

      function showSlide(index) {
        currentSlide = (index + totalSlides) % totalSlides;

        slides.forEach(function(s, i) {
          s.classList.toggle('active', i === currentSlide);
        });

        dots.forEach(function(d, i) {
          d.classList.toggle('active', i === currentSlide);
        });

        thumbs.forEach(function(t, i) {
          t.classList.toggle('active', i === currentSlide);
        });
      }

      function next() {
        showSlide(currentSlide + 1);
      }

      function prev() {
        showSlide(currentSlide - 1);
      }

      function startAutoPlay() {
        stopAutoPlay();
        slideInterval = setInterval(next, intervalDuration);
      }

      function stopAutoPlay() {
        if (slideInterval) {
          clearInterval(slideInterval);
          slideInterval = null;
        }
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          next();
          startAutoPlay();
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          prev();
          startAutoPlay();
        });
      }

      thumbs.forEach(function(thumb) {
        thumb.addEventListener('click', function(e) {
          e.preventDefault();
          var target = parseInt(this.getAttribute('data-slide-target'), 10);
          showSlide(target);
          startAutoPlay();
        });
      });

      dots.forEach(function(dot) {
        dot.addEventListener('click', function(e) {
          e.preventDefault();
          var target = parseInt(this.getAttribute('data-index'), 10);
          showSlide(target);
          startAutoPlay();
        });
      });

      // Quick Night Glow Simulator Button
      if (glowBtn) {
        glowBtn.addEventListener('click', function(e) {
          e.preventDefault();
          showSlide(3); // Slide 3 is the Cyan Night Glow
          startAutoPlay();
        });
      }

      // Pause on hover
      if (wrapper) {
        wrapper.addEventListener('mouseenter', stopAutoPlay);
        wrapper.addEventListener('mouseleave', startAutoPlay);
      }

      // Start automatic movement
      startAutoPlay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGallery);
    } else {
      initGallery();
    }
  })();
</script>

{% schema %}
{
  "name": "Retrotick Single Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Select Product"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Custom Title Override",
      "default": "Casio Vintage Unisex Stainless Steel Watch"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The definitive 1980s retro icon. Engineered in surgical-grade stainless steel with 30M water-resistance, 7-year battery, and signature cyan ElectroLuminescence backlight."
    }
  ],
  "presets": [
    {
      "name": "Retrotick Single Product"
    }
  ]
}
{% endschema %}
