{%- liquid
  assign product = section.settings.product | default: collections.all.products.first
  assign current_variant = product.selected_or_first_available_variant
-%}

<section class="rt-product-section" id="TheWatch">
  <div class="rt-product-container">
    <!-- Media / Gallery Carousel Side -->
    <div class="rt-gallery" id="RtGalleryWrapper">
      <div class="rt-slider-container">
        <!-- Floating Badge -->
        <span class="rt-image-badge">
          <span>✦</span> 100% Original Japanese Quartz
        </span>

        <!-- Slides Track -->
        <div class="rt-slider-track" id="RtSliderTrack">
          <!-- Slide 1: Featured Image or Fallback -->
          <div class="rt-slide" data-slide-index="0">
            {%- if product.featured_image != blank -%}
              <img
                src="{{ product.featured_image | image_url: width: 900 }}"
                alt="{{ product.title | escape }}"
                class="rt-slide-img"
                loading="eager"
                width="600"
                height="600"
              >
            {%- else -%}
              <img
                src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=900&q=80"
                alt="Casio Vintage Stainless Steel Watch"
                class="rt-slide-img"
                loading="eager"
                width="600"
                height="600"
              >
            {%- endif -%}
          </div>

          <!-- Slide 2: Second product image or curated angle -->
          <div class="rt-slide" data-slide-index="1">
            {%- if product.images.size > 1 -%}
              <img
                src="{{ product.images[1] | image_url: width: 900 }}"
                alt="Casio Vintage Steel Angle View"
                class="rt-slide-img"
                loading="lazy"
                width="600"
                height="600"
              >
            {%- else -%}
              <img
                src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=900&q=80"
                alt="Casio Vintage Steel Profile"
                class="rt-slide-img"
                loading="lazy"
                width="600"
                height="600"
              >
            {%- endif -%}
          </div>

          <!-- Slide 3: Third product image or on-wrist lifestyle -->
          <div class="rt-slide" data-slide-index="2">
            {%- if product.images.size > 2 -%}
              <img
                src="{{ product.images[2] | image_url: width: 900 }}"
                alt="Casio Vintage Wrist View"
                class="rt-slide-img"
                loading="lazy"
                width="600"
                height="600"
              >
            {%- else -%}
              <img
                src="https://images.unsplash.com/photo-1542496658-e33a6d0d50f6?auto=format&fit=crop&w=900&q=80"
                alt="Casio Unisex On Wrist"
                class="rt-slide-img"
                loading="lazy"
                width="600"
                height="600"
              >
            {%- endif -%}
          </div>

          <!-- Slide 4: Night glow / Illuminator view -->
          <div class="rt-slide" data-slide-index="3">
            {%- if product.images.size > 3 -%}
              <img
                src="{{ product.images[3] | image_url: width: 900 }}"
                alt="Casio EL Backlight Glow"
                class="rt-slide-img"
                loading="lazy"
                width="600"
                height="600"
              >
            {%- else -%}
              <img
                src="https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?auto=format&fit=crop&w=900&q=80"
                alt="Casio Cyan Backlight"
                class="rt-slide-img"
                loading="lazy"
                width="600"
                height="600"
              >
            {%- endif -%}
          </div>
        </div>

        <!-- Slider Arrows -->
        <button type="button" class="rt-slider-arrow rt-arrow-prev" id="RtPrevSlide" aria-label="Previous Slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="rt-slider-arrow rt-arrow-next" id="RtNextSlide" aria-label="Next Slide">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        <!-- Slider Dots -->
        <div class="rt-slider-dots" id="RtSliderDots">
          <button type="button" class="rt-dot active" data-index="0" aria-label="Go to slide 1"></button>
          <button type="button" class="rt-dot" data-index="1" aria-label="Go to slide 2"></button>
          <button type="button" class="rt-dot" data-index="2" aria-label="Go to slide 3"></button>
          <button type="button" class="rt-dot" data-index="3" aria-label="Go to slide 4"></button>
        </div>
      </div>

      <!-- Thumbnail Row -->
      <div class="rt-thumbnails" id="RtThumbnails">
        <button type="button" class="rt-thumb-item active" data-index="0">
          <span class="rt-thumb-tag">Dial</span>
        </button>
        <button type="button" class="rt-thumb-item" data-index="1">
          <span class="rt-thumb-tag">Steel</span>
        </button>
        <button type="button" class="rt-thumb-item" data-index="2">
          <span class="rt-thumb-tag">On Wrist</span>
        </button>
        <button type="button" class="rt-thumb-item" data-index="3">
          <span class="rt-thumb-tag">EL Glow</span>
        </button>
      </div>
    </div>

    <!-- Info / Conversion Side -->
    <div class="rt-info">
      <div class="rt-status-pill">
        <span class="rt-pulse-dot"></span>
        <span>In Stock • Dispatches Under 24 Hours</span>
      </div>

      <h1 class="rt-product-title">
        {{ section.settings.title | default: product.title | default: "Casio Vintage Unisex Stainless Steel Watch" }}
      </h1>

      <p class="rt-product-subtitle">
        {{ section.settings.subtitle | default: "The timeless 1980s retro icon. Engineered in surgical stainless steel, water-resistant, with signature blue ElectroLuminescence backlight." }}
      </p>

      <div class="rt-rating-row">
        <div class="rt-stars">★★★★★</div>
        <span class="rt-rating-text"><strong>4.9 / 5.0</strong> (1,480+ Reviews)</span>
        <span class="rt-rating-badge">#1 Best Seller</span>
      </div>

      <!-- Price Box (Fixed to ₹999 with ₹1,999 cut and 50% OFF) -->
      <div class="rt-price-box">
        <div class="rt-price-wrap">
          <span class="rt-current-price" id="RtPrice">₹999.00</span>
          <span class="rt-original-price" id="RtComparePrice">₹1,999.00</span>
          <span class="rt-discount-pill">50% OFF</span>
        </div>
        <div class="rt-tax-text">
          ⚡ <strong>Flash Deal:</strong> ₹1,000 Flat Discount Applied • Free Shipping Across India • Cash On Delivery Available
        </div>
      </div>

      <!-- Key Feature Pills -->
      <div class="rt-pill-grid">
        <div class="rt-pill-item">
          <span class="rt-pill-icon">⚙️</span>
          <span>Japanese Quartz Module</span>
        </div>
        <div class="rt-pill-item">
          <span class="rt-pill-icon">🛡️</span>
          <span>Stainless Steel Link Band</span>
        </div>
        <div class="rt-pill-item">
          <span class="rt-pill-icon">💧</span>
          <span>30M Water Resistant</span>
        </div>
        <div class="rt-pill-item">
          <span class="rt-pill-icon">💡</span>
          <span>ElectroLuminescent Glow</span>
        </div>
        <div class="rt-pill-item">
          <span class="rt-pill-icon">🔋</span>
          <span>7-Year Long Battery</span>
        </div>
        <div class="rt-pill-item">
          <span class="rt-pill-icon">🔄</span>
          <span>30 Days Return Guarantee</span>
        </div>
      </div>

      <!-- Purchase Form -->
      {%- if product != blank -%}
        {%- form 'product', product, id: 'RtProductForm' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="RtVariantId">
          <input type="hidden" name="quantity" value="1">

          <div class="rt-actions-wrap">
            <button type="submit" class="rt-btn-buy-now" name="add" data-buy-now="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>ORDER NOW — ₹999 (CASH ON DELIVERY)</span>
            </button>
            <button type="submit" class="rt-btn-add-cart" name="add">
              <span>Add to Cart</span>
            </button>
          </div>
        {%- endform -%}
      {%- else -%}
        <div class="rt-actions-wrap">
          <a href="/cart" class="rt-btn-buy-now">
            <span>ORDER NOW — ₹999 (CASH ON DELIVERY)</span>
          </a>
        </div>
      {%- endif -%}

      <!-- Trust & Guarantees -->
      <div class="rt-guarantees-grid">
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <div>
            <div class="rt-guarantee-title">100% Genuine Casio</div>
            <div class="rt-guarantee-sub">Original box & paperwork</div>
          </div>
        </div>
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
          <div>
            <div class="rt-guarantee-title">Free Express Shipping</div>
            <div class="rt-guarantee-sub">Fast dispatch under 24 hr</div>
          </div>
        </div>
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <div>
            <div class="rt-guarantee-title">30-Day Return Policy</div>
            <div class="rt-guarantee-sub">Hassle-free replacement</div>
          </div>
        </div>
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
          <div>
            <div class="rt-guarantee-title">Cash On Delivery (COD)</div>
            <div class="rt-guarantee-sub">Pay safely at doorstep</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Automatic 5-Second Carousel Script -->
<script>
  (function() {
    function initSlider() {
      const track = document.getElementById('RtSliderTrack');
      const dots = document.querySelectorAll('#RtSliderDots .rt-dot');
      const thumbs = document.querySelectorAll('#RtThumbnails .rt-thumb-item');
      const prevBtn = document.getElementById('RtPrevSlide');
      const nextBtn = document.getElementById('RtNextSlide');
      const wrapper = document.getElementById('RtGalleryWrapper');

      if (!track) return;

      let currentIndex = 0;
      const totalSlides = 4;
      const intervalTime = 5000; // 5 seconds
      let slideTimer = null;

      function goToSlide(index) {
        currentIndex = (index + totalSlides) % totalSlides;
        track.style.transform = `translateX(-${currentIndex * 100}%)`;

        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === currentIndex);
        });
        thumbs.forEach((thumb, i) => {
          thumb.classList.toggle('active', i === currentIndex);
        });
      }

      function nextSlide() {
        goToSlide(currentIndex + 1);
      }

      function prevSlide() {
        goToSlide(currentIndex - 1);
      }

      function startTimer() {
        stopTimer();
        slideTimer = setInterval(nextSlide, intervalTime);
      }

      function stopTimer() {
        if (slideTimer) {
          clearInterval(slideTimer);
          slideTimer = null;
        }
      }

      // Event listeners
      if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); startTimer(); });
      if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); startTimer(); });

      dots.forEach(dot => {
        dot.addEventListener('click', function() {
          const idx = parseInt(this.getAttribute('data-index'), 10);
          goToSlide(idx);
          startTimer();
        });
      });

      thumbs.forEach(thumb => {
        thumb.addEventListener('click', function() {
          const idx = parseInt(this.getAttribute('data-index'), 10);
          goToSlide(idx);
          startTimer();
        });
      });

      // Pause on hover
      if (wrapper) {
        wrapper.addEventListener('mouseenter', stopTimer);
        wrapper.addEventListener('mouseleave', startTimer);
      }

      // Start automatic 5-second movement
      startTimer();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSlider);
    } else {
      initSlider();
    }
  })();
</script>

{% schema %}
{
  "name": "Retrotick Single Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Select Product (Optional, auto-selects first product)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Custom Title Override",
      "default": "Casio Vintage Unisex Stainless Steel Watch"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The timeless 1980s retro icon. Engineered in surgical stainless steel, water-resistant, with signature blue ElectroLuminescence backlight."
    }
  ],
  "presets": [
    {
      "name": "Retrotick Single Product"
    }
  ]
}
{% endschema %}
