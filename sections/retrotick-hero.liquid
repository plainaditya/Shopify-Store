{%- liquid
  assign product = section.settings.product | default: collections.all.products.first
  assign current_variant = product.selected_or_first_available_variant
  assign compare_price = current_variant.compare_at_price | default: section.settings.fallback_compare_price
  assign price = current_variant.price | default: section.settings.fallback_price
  assign is_available = current_variant.available | default: true
-%}

<section class="rt-product-section" id="TheWatch">
  <div class="rt-product-container">
    <!-- Media / Gallery Side -->
    <div class="rt-gallery">
      <div class="rt-main-image-wrap">
        <span class="rt-image-badge">
          <span>✦</span> 100% Original Japanese Quartz
        </span>
        {%- if product.featured_image != blank -%}
          <img
            id="RtMainImage"
            class="rt-main-image"
            src="{{ product.featured_image | image_url: width: 900 }}"
            alt="{{ product.title | escape }}"
            loading="eager"
            width="600"
            height="600"
          >
        {%- else -%}
          <img
            id="RtMainImage"
            class="rt-main-image"
            src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=900&q=80"
            alt="Casio Vintage Stainless Steel Watch"
            loading="eager"
            width="600"
            height="600"
          >
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="rt-thumbnails" id="RtThumbnails">
          {%- for image in product.images -%}
            <button
              type="button"
              class="rt-thumb-item {% if forloop.first %}active{% endif %}"
              data-image-src="{{ image | image_url: width: 900 }}"
              aria-label="View product image {{ forloop.index }}"
            >
              <img src="{{ image | image_url: width: 140, height: 140, crop: 'center' }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Info / Conversion Side -->
    <div class="rt-info">
      <div class="rt-status-pill">
        <span class="rt-pulse-dot"></span>
        <span>In Stock • Dispatches Within 24 Hours</span>
      </div>

      <h1 class="rt-product-title">
        {{ section.settings.title | default: product.title | default: "Casio Vintage Unisex Stainless Steel Watch" }}
      </h1>

      <p class="rt-product-subtitle">
        {{ section.settings.subtitle | default: "The timeless 1980s retro icon. Engineered in surgical stainless steel, water-resistant, with signature blue ElectroLuminescence backlight." }}
      </p>

      <div class="rt-rating-row">
        <div class="rt-stars">★★★★★</div>
        <span class="rt-rating-text"><strong>4.9 / 5.0</strong> (1,480+ Reviews)</span>
        <span class="rt-rating-badge">#1 Best Seller</span>
      </div>

      <!-- Price Box -->
      <div class="rt-price-box">
        <div class="rt-price-wrap">
          <span class="rt-current-price" id="RtPrice">
            {%- if product != blank -%}
              {{ price | money }}
            {%- else -%}
              ₹1,895.00
            {%- endif -%}
          </span>
          {%- if compare_price > price or section.settings.show_compare_price -%}
            <span class="rt-original-price" id="RtComparePrice">
              {%- if product != blank and compare_price > price -%}
                {{ compare_price | money }}
              {%- else -%}
                ₹2,695.00
              {%- endif -%}
            </span>
            <span class="rt-discount-pill">Save 30% OFF</span>
          {%- endif -%}
        </div>
        <div class="rt-tax-text">Inclusive of all taxes • Free shipping across India • Cash on Delivery Available</div>
      </div>

      <!-- Key Feature Pills -->
      <div class="rt-pill-grid">
        <div class="rt-pill-item">
          <span class="rt-pill-icon">⚙️</span>
          <span>Japanese Quartz Module</span>
        </div>
        <div class="rt-pill-item">
          <span class="rt-pill-icon">🛡️</span>
          <span>Stainless Steel Link Band</span>
        </div>
        <div class="rt-pill-item">
          <span class="rt-pill-icon">💧</span>
          <span>30M Water Resistant</span>
        </div>
        <div class="rt-pill-item">
          <span class="rt-pill-icon">💡</span>
          <span>ElectroLuminescent Glow</span>
        </div>
        <div class="rt-pill-item">
          <span class="rt-pill-icon">🔋</span>
          <span>7-Year Long Battery</span>
        </div>
        <div class="rt-pill-item">
          <span class="rt-pill-icon">✨</span>
          <span>Self-Adjustable Unisex Clasp</span>
        </div>
      </div>

      <!-- Purchase Form -->
      {%- if product != blank -%}
        {%- form 'product', product, id: 'RtProductForm' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="RtVariantId">
          <input type="hidden" name="quantity" value="1">

          <div class="rt-actions-wrap">
            <button type="submit" class="rt-btn-buy-now" name="add" data-buy-now="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>ORDER NOW — CASH ON DELIVERY</span>
            </button>
            <button type="submit" class="rt-btn-add-cart" name="add">
              <span>Add to Cart</span>
            </button>
          </div>
        {%- endform -%}
      {%- else -%}
        <div class="rt-actions-wrap">
          <a href="/cart" class="rt-btn-buy-now">
            <span>ORDER NOW — CASH ON DELIVERY</span>
          </a>
        </div>
      {%- endif -%}

      <!-- Trust & Guarantees -->
      <div class="rt-guarantees-grid">
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <div>
            <div class="rt-guarantee-title">100% Genuine Casio</div>
            <div class="rt-guarantee-sub">Original box & paperwork</div>
          </div>
        </div>
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
          <div>
            <div class="rt-guarantee-title">Free Express Shipping</div>
            <div class="rt-guarantee-sub">Fast delivery across India</div>
          </div>
        </div>
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <div>
            <div class="rt-guarantee-title">7-Day Replacement</div>
            <div class="rt-guarantee-sub">Hassle-free guarantee</div>
          </div>
        </div>
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
          <div>
            <div class="rt-guarantee-title">Pay On Delivery (COD)</div>
            <div class="rt-guarantee-sub">Pay safely at doorstep</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mainImg = document.getElementById('RtMainImage');
    const thumbs = document.querySelectorAll('#RtThumbnails .rt-thumb-item');
    thumbs.forEach(thumb => {
      thumb.addEventListener('click', function() {
        thumbs.forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        const newSrc = this.getAttribute('data-image-src');
        if (mainImg && newSrc) {
          mainImg.src = newSrc;
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Retrotick Single Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Select Product (Optional, auto-selects first product)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Custom Title Override",
      "default": "Casio Vintage Unisex Stainless Steel Watch"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The timeless 1980s retro icon. Engineered in surgical stainless steel, water-resistant, with signature blue ElectroLuminescence backlight."
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show Original Strikethrough Price",
      "default": true
    },
    {
      "type": "number",
      "id": "fallback_price",
      "label": "Fallback Price (in paise, e.g. 189500)",
      "default": 189500
    },
    {
      "type": "number",
      "id": "fallback_compare_price",
      "label": "Fallback Compare Price (in paise, e.g. 269500)",
      "default": 269500
    }
  ],
  "presets": [
    {
      "name": "Retrotick Single Product"
    }
  ]
}
{% endschema %}
