{%- liquid
  assign product = section.settings.product | default: collections.all.products.first
  assign current_variant = product.selected_or_first_available_variant
  assign main_img = product.featured_image
-%}

<section class="rt-product-section" id="TheWatch">
  <div class="rt-product-container">
    <!-- Gallery Carousel Showcase -->
    <div class="rt-gallery" id="RtGalleryWrapper">
      <div class="rt-gallery-stage">
        <!-- Floating Live Badge -->
        <div class="rt-stage-badge">
          <span class="rt-badge-pulse"></span>
          <span>100% Original Casio Quartz</span>
        </div>

        <!-- Slides Container (Crossfade Architecture) -->
        <div class="rt-slides-viewport" id="RtSlidesViewport">
          <!-- Slide 0: Front Dial View -->
          <div class="rt-slide-panel active" data-slide="0">
            <div class="rt-img-frame">
              {%- if main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 800 }}"
                  srcset="{{ main_img | image_url: width: 400 }} 400w, {{ main_img | image_url: width: 600 }} 600w, {{ main_img | image_url: width: 800 }} 800w, {{ main_img | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 768px) 92vw, 600px"
                  alt="{{ product.title | escape }} - Dial View"
                  class="rt-stage-img"
                  loading="eager"
                  fetchpriority="high"
                  width="800"
                  height="800"
                >
              {%- else -%}
                <img
                  src="{{ 'casio-fallback-dial.jpg' | asset_url }}"
                  alt="Casio Vintage Stainless Steel Watch"
                  class="rt-stage-img"
                  loading="eager"
                  fetchpriority="high"
                  width="800"
                  height="800"
                >
              {%- endif -%}
            </div>
            <div class="rt-slide-caption">VIEW 01 // FRONT DIAL</div>
          </div>

          <!-- Slide 1: Cyan EL Backlight Night Glow (Moved to 2nd Position) -->
          <div class="rt-slide-panel rt-slide-night" data-slide="1">
            <div class="rt-img-frame rt-frame-glow rt-frame-el-glow">
              <img
                src="{{ 'casio-el-backlight.jpg' | asset_url }}"
                alt="Casio Vintage EL Night Backlight"
                class="rt-stage-img rt-img-el-real"
                loading="lazy"
                decoding="async"
                width="800"
                height="800"
              >
            </div>
            <div class="rt-slide-caption rt-caption-glow">VIEW 02 // EL NIGHT BACKLIGHT</div>
          </div>

          <!-- Slide 2: Dial & Casing Close-Up (Shifted to 3rd Position) -->
          <div class="rt-slide-panel" data-slide="2">
            <div class="rt-img-frame rt-frame-zoom">
              {%- if product.images.size > 1 -%}
                <img
                  src="{{ product.images[1] | image_url: width: 800 }}"
                  srcset="{{ product.images[1] | image_url: width: 400 }} 400w, {{ product.images[1] | image_url: width: 600 }} 600w, {{ product.images[1] | image_url: width: 800 }} 800w, {{ product.images[1] | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 768px) 92vw, 600px"
                  alt="Casio Dial Close Up"
                  class="rt-stage-img"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="800"
                >
              {%- elsif main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 800 }}"
                  srcset="{{ main_img | image_url: width: 400 }} 400w, {{ main_img | image_url: width: 600 }} 600w, {{ main_img | image_url: width: 800 }} 800w, {{ main_img | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 768px) 92vw, 600px"
                  alt="Casio Dial Detail"
                  class="rt-stage-img rt-img-macro"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="800"
                >
              {%- else -%}
                <img
                  src="{{ 'casio-fallback-detail.jpg' | asset_url }}"
                  alt="Casio Vintage Close Up"
                  class="rt-stage-img"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="800"
                >
              {%- endif -%}
            </div>
            <div class="rt-slide-caption">VIEW 03 // MACRO DETAIL</div>
          </div>

          <!-- Slide 3: Stainless Steel Bracelet View (Shifted to 4th Position) -->
          <div class="rt-slide-panel" data-slide="3">
            <div class="rt-img-frame rt-frame-bracelet">
              {%- if product.images.size > 2 -%}
                <img
                  src="{{ product.images[2] | image_url: width: 800 }}"
                  srcset="{{ product.images[2] | image_url: width: 400 }} 400w, {{ product.images[2] | image_url: width: 600 }} 600w, {{ product.images[2] | image_url: width: 800 }} 800w, {{ product.images[2] | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 768px) 92vw, 600px"
                  alt="Casio Steel Bracelet"
                  class="rt-stage-img"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="800"
                >
              {%- elsif main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 800 }}"
                  srcset="{{ main_img | image_url: width: 400 }} 400w, {{ main_img | image_url: width: 600 }} 600w, {{ main_img | image_url: width: 800 }} 800w, {{ main_img | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 768px) 92vw, 600px"
                  alt="Casio Steel Links"
                  class="rt-stage-img rt-img-angle"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="800"
                >
              {%- else -%}
                <img
                  src="{{ 'casio-fallback-steel.jpg' | asset_url }}"
                  alt="Casio Steel Links"
                  class="rt-stage-img"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="800"
                >
              {%- endif -%}
            </div>
            <div class="rt-slide-caption">VIEW 04 // 316L STEEL BRACELET</div>
          </div>

          <!-- Slide 4: Case & Side Profile (Shifted to 5th Position) -->
          <div class="rt-slide-panel" data-slide="4">
            <div class="rt-img-frame rt-frame-profile">
              {%- if product.images.size > 3 -%}
                <img
                  src="{{ product.images[3] | image_url: width: 800 }}"
                  srcset="{{ product.images[3] | image_url: width: 400 }} 400w, {{ product.images[3] | image_url: width: 600 }} 600w, {{ product.images[3] | image_url: width: 800 }} 800w, {{ product.images[3] | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 768px) 92vw, 600px"
                  alt="Casio Case & Side Profile"
                  class="rt-stage-img"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="800"
                >
              {%- elsif main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 800 }}"
                  srcset="{{ main_img | image_url: width: 400 }} 400w, {{ main_img | image_url: width: 600 }} 600w, {{ main_img | image_url: width: 800 }} 800w, {{ main_img | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 768px) 92vw, 600px"
                  alt="Casio Case & Side Profile"
                  class="rt-stage-img"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="800"
                >
              {%- else -%}
                <img
                  src="{{ 'casio-fallback-detail.jpg' | asset_url }}"
                  alt="Casio Case & Side Profile"
                  class="rt-stage-img"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="800"
                >
              {%- endif -%}
            </div>
            <div class="rt-slide-caption">VIEW 05 // CASE & PROFILE</div>
          </div>
        </div>

        <!-- Carousel Navigation Arrows -->
        <button type="button" class="rt-nav-arrow rt-nav-prev" id="RtNavPrev" aria-label="Previous View">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="rt-nav-arrow rt-nav-next" id="RtNavNext" aria-label="Next View">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        <!-- Progress Indicator Dots -->
        <div class="rt-progress-dots" id="RtProgressDots">
          <button type="button" class="rt-dot-bar active" data-index="0" aria-label="View 1"></button>
          <button type="button" class="rt-dot-bar" data-index="1" aria-label="View 2"></button>
          <button type="button" class="rt-dot-bar" data-index="2" aria-label="View 3"></button>
          <button type="button" class="rt-dot-bar" data-index="3" aria-label="View 4"></button>
          <button type="button" class="rt-dot-bar" data-index="4" aria-label="View 5"></button>
        </div>
      </div>

      <!-- Visible Visual Thumbnails Row with 5 Image Previews (New Order: Dial, EL Glow, Close-Up, Steel Band, Profile) -->
      <div class="rt-thumb-gallery" id="RtThumbGallery">
        <!-- 1st Thumbnail: Dial -->
        <button type="button" class="rt-thumb-card active" data-slide-target="0">
          <div class="rt-thumb-preview">
            {%- if main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Dial" width="140" height="140" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{{ 'casio-fallback-dial.jpg' | asset_url }}" alt="Dial" width="140" height="140" loading="lazy" decoding="async">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">Dial</span>
        </button>

        <!-- 2nd Thumbnail: EL Glow (Moved to 2nd Position) -->
        <button type="button" class="rt-thumb-card rt-thumb-card-glow" data-slide-target="1">
          <div class="rt-thumb-preview">
            <img src="{{ 'casio-el-backlight.jpg' | asset_url }}" alt="EL Glow" width="140" height="140" loading="lazy" decoding="async">
          </div>
          <span class="rt-thumb-title">EL Glow 💡</span>
        </button>

        <!-- 3rd Thumbnail: Close-Up (Shifted to 3rd Position) -->
        <button type="button" class="rt-thumb-card" data-slide-target="2">
          <div class="rt-thumb-preview">
            {%- if product.images.size > 1 -%}
              <img src="{{ product.images[1] | image_url: width: 140, height: 140, crop: 'center' }}" alt="Close Up" width="140" height="140" loading="lazy" decoding="async">
            {%- elsif main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Close Up" style="transform: scale(1.4);" width="140" height="140" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{{ 'casio-fallback-detail.jpg' | asset_url }}" alt="Close Up" width="140" height="140" loading="lazy" decoding="async">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">Close-Up</span>
        </button>

        <!-- 4th Thumbnail: Steel Band (Shifted to 4th Position) -->
        <button type="button" class="rt-thumb-card" data-slide-target="3">
          <div class="rt-thumb-preview">
            {%- if product.images.size > 2 -%}
              <img src="{{ product.images[2] | image_url: width: 140, height: 140, crop: 'center' }}" alt="Steel" width="140" height="140" loading="lazy" decoding="async">
            {%- elsif main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Steel" style="transform: rotate(20deg);" width="140" height="140" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{{ 'casio-fallback-steel.jpg' | asset_url }}" alt="Steel" width="140" height="140" loading="lazy" decoding="async">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">Steel Band</span>
        </button>

        <!-- 5th Thumbnail: Profile (Shifted to 5th Position) -->
        <button type="button" class="rt-thumb-card" data-slide-target="4">
          <div class="rt-thumb-preview">
            {%- if product.images.size > 3 -%}
              <img src="{{ product.images[3] | image_url: width: 140, height: 140, crop: 'center' }}" alt="Profile" width="140" height="140" loading="lazy" decoding="async">
            {%- elsif main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Profile" width="140" height="140" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{{ 'casio-fallback-detail.jpg' | asset_url }}" alt="Profile" width="140" height="140" loading="lazy" decoding="async">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">Profile</span>
        </button>
      </div>

      <!-- Quick Backlight Glow Simulator Pill -->
      <button type="button" class="rt-glow-simulator-btn" id="RtGlowSimulatorBtn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#00f0ff" stroke="#00f0ff" stroke-width="1.5">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>Click to test EL Night Backlight</span>
      </button>
    </div>

    <!-- Info / Conversion Engine Side -->
    <div class="rt-info">
      <!-- Live Inventory & Dispatch Status (Human & Authentic) -->
      <div class="rt-stock-alert">
        <span class="rt-pulse-live"></span>
        <span>IN STOCK • DISPATCHES WITHIN 24 HOURS FROM MUMBAI</span>
      </div>

      <div class="rt-product-header">
        <span class="rt-category-tag">CASIO ARCHIVE SERIES • 1980s UNISEX ICON</span>
        <h1 class="rt-product-title">
          {{ section.settings.title | default: product.title | default: "Casio Vintage A168W Stainless Steel Watch" }}
        </h1>
        <p class="rt-product-subtitle">
          {{ section.settings.subtitle | default: "The definitive 1980s Japanese classic that never went out of style. Built in durable chrome-plated steel with Casio’s original cyan ElectroLuminescence backlight, daily alarm, stopwatch, and a bulletproof 7-year battery." }}
        </p>
      </div>

      <!-- Human Social Proof Rating with Buyer Avatars -->
      <div class="rt-rating-row">
        <div class="rt-avatar-stack">
          <img src="{{ 'avatar-1.jpg' | asset_url }}" alt="Verified Buyer" class="rt-avatar-img" width="28" height="28" loading="lazy" decoding="async">
          <img src="{{ 'avatar-2.jpg' | asset_url }}" alt="Verified Buyer" class="rt-avatar-img" width="28" height="28" loading="lazy" decoding="async">
          <img src="{{ 'avatar-3.jpg' | asset_url }}" alt="Verified Buyer" class="rt-avatar-img" width="28" height="28" loading="lazy" decoding="async">
          <img src="{{ 'avatar-4.jpg' | asset_url }}" alt="Verified Buyer" class="rt-avatar-img" width="28" height="28" loading="lazy" decoding="async">
        </div>
        <div class="rt-rating-details">
          <div class="rt-stars">★★★★★</div>
          <span class="rt-rating-score">4.9 / 5.0</span>
          <span class="rt-review-count">• 1,480+ happy buyers across India</span>
        </div>
      </div>

      <!-- Classy, High-Trust Price Box With Limited Time Deal Timer -->
      <div class="rt-price-box">
        <div class="rt-price-row">
          <div class="rt-price-left">
            <div class="rt-price-main">
              <span class="rt-currency">₹</span><span class="rt-amount">999</span>
            </div>
            <div class="rt-price-compare">
              <span class="rt-mrp-label">M.R.P.</span>
              <span class="rt-cut-price">₹1,999</span>
              <span class="rt-discount-pill">50% OFF</span>
            </div>
          </div>

          <!-- Limited Time Deal Urgency Timer Beside Price -->
          <div class="rt-deal-timer-wrap" id="RtDealTimer" aria-label="Limited Time Offer Countdown">
            <div class="rt-deal-timer-top">
              <span class="rt-timer-fire">⚡</span>
              <span class="rt-deal-timer-heading">SPECIAL PRICE EXPIRES IN</span>
            </div>
            <div class="rt-deal-countdown">
              <div class="rt-count-box">
                <span class="rt-count-num" id="RtTimerHours">02</span>
                <span class="rt-count-lbl">H</span>
              </div>
              <span class="rt-count-sep">:</span>
              <div class="rt-count-box">
                <span class="rt-count-num" id="RtTimerMinutes">48</span>
                <span class="rt-count-lbl">M</span>
              </div>
              <span class="rt-count-sep">:</span>
              <div class="rt-count-box">
                <span class="rt-count-num" id="RtTimerSeconds">35</span>
                <span class="rt-count-lbl">S</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Human Delivery Reassurance Banner -->
        <div class="rt-delivery-promise-card">
          <div class="rt-promise-icon">🚚</div>
          <div class="rt-promise-text">
            <strong>Free Express Doorstep Delivery Across India</strong>
            <span>Order now & receive in 2–4 business days via BlueDart / Delhivery</span>
          </div>
        </div>
      </div>

      <!-- Purchase Actions: One Big Full-Width Primary CTA + Subtle Secondary Option -->
      {%- if product != blank -%}
        {%- form 'product', product, id: 'RtProductForm' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="RtVariantId">
          <input type="hidden" name="quantity" value="1">

          <div class="rt-actions-wrap">
            <button type="submit" class="rt-btn-buy-now" name="add" data-buy-now="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="rt-btn-lock-icon"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              <span>Order Now – ₹999 (COD)</span>
            </button>
            <button type="submit" class="rt-btn-add-cart-secondary" name="add">
              <span>+ Add to Cart</span>
            </button>
          </div>
        {%- endform -%}
      {%- else -%}
        <div class="rt-actions-wrap">
          <a href="/cart" class="rt-btn-buy-now">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="rt-btn-lock-icon"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>Order Now – ₹999 (COD)</span>
          </a>
          <a href="/cart" class="rt-btn-add-cart-secondary">
            <span>+ Add to Cart</span>
          </a>
        </div>
      {%- endif -%}

      <!-- Human Frictionless Doorstep Inspection Note -->
      <div class="rt-zero-risk-note">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span><strong>100% Risk-Free:</strong> Open & inspect your watch at your doorstep before paying</span>
      </div>

      <!-- Single Compact Row of 4 Trust Icons Under The Button -->
      <div class="rt-trust-compact-row">
        <div class="rt-trust-compact-item">
          <div class="rt-trust-compact-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          </div>
          <div class="rt-trust-compact-label">
            <span>Free Express</span>
            <span>Delivery</span>
          </div>
        </div>

        <div class="rt-trust-compact-item">
          <div class="rt-trust-compact-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="2"></circle><path d="M6 12h.01M18 12h.01"></path></svg>
          </div>
          <div class="rt-trust-compact-label">
            <span>Cash On</span>
            <span>Delivery</span>
          </div>
        </div>

        <div class="rt-trust-compact-item">
          <div class="rt-trust-compact-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
          </div>
          <div class="rt-trust-compact-label">
            <span>100% Genuine</span>
            <span>Casio</span>
          </div>
        </div>

        <div class="rt-trust-compact-item">
          <div class="rt-trust-compact-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
          </div>
          <div class="rt-trust-compact-label">
            <span>30-Day Easy</span>
            <span>Returns</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Rock-Solid 5-Second Carousel & Glow Simulator JavaScript -->
<script>
  (function() {
    function initGallery() {
      var slides = document.querySelectorAll('#RtSlidesViewport .rt-slide-panel');
      var dots = document.querySelectorAll('#RtProgressDots .rt-dot-bar');
      var thumbs = document.querySelectorAll('#RtThumbGallery .rt-thumb-card');
      var prevBtn = document.getElementById('RtNavPrev');
      var nextBtn = document.getElementById('RtNavNext');
      var glowBtn = document.getElementById('RtGlowSimulatorBtn');
      var wrapper = document.getElementById('RtGalleryWrapper');

      if (!slides.length) return;

      var currentSlide = 0;
      var totalSlides = slides.length;
      var slideInterval = null;
      var intervalDuration = 5000; // 5 seconds

      function isCartOpen() {
        var drawer = document.getElementById('cart-drawer');
        if (drawer && (drawer.hasAttribute('open') || drawer.classList.contains('active'))) return true;
        var dialog = document.querySelector('dialog.theme-drawer__dialog[open], dialog[open]');
        if (dialog) return true;
        var trigger = document.querySelector('[data-testid="cart-drawer-trigger"][aria-expanded="true"]');
        if (trigger) return true;
        return false;
      }

      function updateThemeForSlide(slideIdx) {
        var isNightSlide = (slideIdx === 1);
        var targetTheme = isNightSlide ? 'dark' : 'light';

        if (glowBtn) {
          var btnSpan = glowBtn.querySelector('span');
          if (btnSpan) {
            if (isNightSlide) {
              btnSpan.textContent = 'EL Night Glow Active (Click to Return to Daylight)';
            } else {
              btnSpan.textContent = 'Click to test EL Night Backlight';
            }
          }
        }

        // Sync header toggle label and checkboxes if present
        var toggleLabel = document.getElementById('RtToggleLabel');
        if (toggleLabel) {
          toggleLabel.textContent = isNightSlide ? 'Dark' : 'Light';
        }
        var toggleInputs = document.querySelectorAll('#rt-theme-checkbox, input.rt-theme-toggle-input');
        toggleInputs.forEach(function(inp) { inp.checked = isNightSlide; });

        // Never override theme in background if user has cart drawer open
        if (isCartOpen()) return;

        var currentTheme = document.documentElement.getAttribute('data-theme');
        if (currentTheme !== targetTheme) {
          document.documentElement.setAttribute('data-theme', targetTheme);
          try {
            localStorage.setItem('retrotick_theme', targetTheme);
          } catch(err) {}
        }
      }

      function showSlide(index) {
        currentSlide = (index + totalSlides) % totalSlides;

        slides.forEach(function(s, i) {
          s.classList.toggle('active', i === currentSlide);
        });

        dots.forEach(function(d, i) {
          d.classList.toggle('active', i === currentSlide);
        });

        thumbs.forEach(function(t, i) {
          t.classList.toggle('active', i === currentSlide);
        });

        // Trigger night dark mode on slide 1 (EL GLOW), daylight on all other slides
        updateThemeForSlide(currentSlide);
      }

      function next() {
        if (isCartOpen()) return;
        showSlide(currentSlide + 1);
      }

      function prev() {
        showSlide(currentSlide - 1);
      }

      function startAutoPlay() {
        stopAutoPlay();
        slideInterval = setInterval(next, intervalDuration);
      }

      function stopAutoPlay() {
        if (slideInterval) {
          clearInterval(slideInterval);
          slideInterval = null;
        }
      }

      // Immediately pause carousel and ensure daylight light mode if Cart drawer opens
      function handleCartOpen() {
        stopAutoPlay();
        if (currentSlide === 1) {
          showSlide(0);
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
          try {
            localStorage.setItem('retrotick_theme', 'light');
          } catch(err) {}
        }
      }

      function handleCartClose() {
        setTimeout(function() {
          if (!isCartOpen()) {
            startAutoPlay();
          }
        }, 400);
      }

      document.addEventListener('theme-drawer:open', handleCartOpen, true);
      document.addEventListener('theme-drawer:close', handleCartClose, true);

      // Proactively catch header cart trigger clicks before drawer completes opening
      document.addEventListener('click', function(e) {
        if (e.target.closest('[data-testid="cart-drawer-trigger"], [aria-controls="cart-drawer"], .cart-bubble, .header-actions__action--cart')) {
          handleCartOpen();
        }
      }, true);

      var cartDrawerEl = document.getElementById('cart-drawer');
      if (cartDrawerEl) {
        var cartObserver = new MutationObserver(function() {
          if (isCartOpen()) {
            handleCartOpen();
          } else {
            handleCartClose();
          }
        });
        cartObserver.observe(cartDrawerEl, { attributes: true, attributeFilter: ['open', 'class'] });
        var dialogEl = cartDrawerEl.querySelector('dialog');
        if (dialogEl) {
          cartObserver.observe(dialogEl, { attributes: true, attributeFilter: ['open', 'class'] });
        }
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          next();
          startAutoPlay();
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          prev();
          startAutoPlay();
        });
      }

      thumbs.forEach(function(thumb) {
        thumb.addEventListener('click', function(e) {
          e.preventDefault();
          var target = parseInt(this.getAttribute('data-slide-target'), 10);
          showSlide(target);
          if (target === 1) {
            stopAutoPlay();
          } else {
            startAutoPlay();
          }
        });
      });

      dots.forEach(function(dot) {
        dot.addEventListener('click', function(e) {
          e.preventDefault();
          var target = parseInt(this.getAttribute('data-index'), 10);
          showSlide(target);
          if (target === 1) {
            stopAutoPlay();
          } else {
            startAutoPlay();
          }
        });
      });

      // Quick Night Glow Simulator Button
      if (glowBtn) {
        glowBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          if (currentSlide === 1) {
            // Already in night view -> return to daylight view (slide 0)
            showSlide(0);
            startAutoPlay();
          } else {
            // Jump directly to 2nd view (EL Glow, slide 1) -> auto-triggers dark mode
            showSlide(1);
            stopAutoPlay();
          }
        });
      }

      // Mobile Touch Swipe Handling
      var touchStartX = 0;
      var touchEndX = 0;
      var stageBox = document.getElementById('RtSlidesViewport');

      if (stageBox) {
        stageBox.addEventListener('touchstart', function(e) {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        stageBox.addEventListener('touchend', function(e) {
          touchEndX = e.changedTouches[0].screenX;
          var diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) {
              next(); // Swipe left -> Next view
            } else {
              prev(); // Swipe right -> Previous view
            }
            startAutoPlay();
          }
        }, { passive: true });
      }

      // Pause on hover
      if (wrapper) {
        wrapper.addEventListener('mouseenter', stopAutoPlay);
        wrapper.addEventListener('mouseleave', startAutoPlay);
      }

      // Pause when tab is hidden or when gallery is scrolled out of viewport
      document.addEventListener('visibilitychange', function() {
        if (document.hidden) {
          stopAutoPlay();
        } else {
          startAutoPlay();
        }
      });

      if ('IntersectionObserver' in window && wrapper) {
        var heroObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              startAutoPlay();
            } else {
              stopAutoPlay();
            }
          });
        }, { threshold: 0.1 });
        heroObserver.observe(wrapper);
      }

      // Start automatic movement
      startAutoPlay();
    }

    function initCountdown() {
      var hoursEl = document.getElementById('RtTimerHours');
      var minsEl = document.getElementById('RtTimerMinutes');
      var secsEl = document.getElementById('RtTimerSeconds');
      if (!hoursEl || !minsEl || !secsEl) return;

      var storageKey = 'rt_deal_timer_end';
      var endTime = parseInt(localStorage.getItem(storageKey), 10);
      var now = Date.now();
      var duration = 2 * 3600 * 1000 + 47 * 60 * 1000 + 35 * 1000; // 2h 47m 35s

      if (!endTime || isNaN(endTime) || endTime <= now) {
        endTime = now + duration;
        try { localStorage.setItem(storageKey, endTime); } catch(e) {}
      }

      function updateTimer() {
        var remaining = Math.max(0, endTime - Date.now());
        if (remaining <= 0) {
          endTime = Date.now() + duration;
          try { localStorage.setItem(storageKey, endTime); } catch(e) {}
          remaining = duration;
        }

        var totalSecs = Math.floor(remaining / 1000);
        var h = Math.floor(totalSecs / 3600);
        var m = Math.floor((totalSecs % 3600) / 60);
        var s = totalSecs % 60;

        hoursEl.textContent = (h < 10 ? '0' : '') + h;
        minsEl.textContent = (m < 10 ? '0' : '') + m;
        secsEl.textContent = (s < 10 ? '0' : '') + s;
      }

      updateTimer();
      setInterval(updateTimer, 1000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        initGallery();
        initCountdown();
      });
    } else {
      initGallery();
      initCountdown();
    }
  })();
</script>

