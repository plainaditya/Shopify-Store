{%- liquid
  assign product = section.settings.product | default: collections.all.products.first
  assign current_variant = product.selected_or_first_available_variant
  assign main_img = product.featured_image
-%}

<section class="rt-product-section" id="TheWatch">
  <div class="rt-product-container">
    <!-- Gallery Carousel Showcase -->
    <div class="rt-gallery" id="RtGalleryWrapper">
      <div class="rt-gallery-stage">
        <!-- Floating Live Badge -->
        <div class="rt-stage-badge">
          <span class="rt-badge-pulse"></span>
          <span>100% Original Casio Quartz</span>
        </div>

        <!-- Slides Container (Crossfade Architecture) -->
        <div class="rt-slides-viewport" id="RtSlidesViewport">
          <!-- Slide 0: Front Dial View -->
          <div class="rt-slide-panel active" data-slide="0">
            <div class="rt-img-frame">
              {%- if main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 1200 }}"
                  alt="{{ product.title | escape }} - Dial View"
                  class="rt-stage-img"
                  loading="eager"
                  width="800"
                  height="800"
                >
              {%- else -%}
                <img
                  src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=1200&q=80"
                  alt="Casio Vintage Stainless Steel Watch"
                  class="rt-stage-img"
                  loading="eager"
                  width="800"
                  height="800"
                >
              {%- endif -%}
            </div>
            <div class="rt-slide-caption">VIEW 01 // FRONT DIAL</div>
          </div>

          <!-- Slide 1: Dial & Casing Close-Up -->
          <div class="rt-slide-panel" data-slide="1">
            <div class="rt-img-frame rt-frame-zoom">
              {%- if product.images.size > 1 -%}
                <img
                  src="{{ product.images[1] | image_url: width: 1200 }}"
                  alt="Casio Dial Close Up"
                  class="rt-stage-img"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {%- elsif main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 1200 }}"
                  alt="Casio Dial Detail"
                  class="rt-stage-img rt-img-macro"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {%- else -%}
                <img
                  src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=1200&q=80"
                  alt="Casio Vintage Close Up"
                  class="rt-stage-img"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {%- endif -%}
            </div>
            <div class="rt-slide-caption">VIEW 02 // MACRO DETAIL</div>
          </div>

          <!-- Slide 2: Stainless Steel Bracelet View -->
          <div class="rt-slide-panel" data-slide="2">
            <div class="rt-img-frame rt-frame-bracelet">
              {%- if product.images.size > 2 -%}
                <img
                  src="{{ product.images[2] | image_url: width: 1200 }}"
                  alt="Casio Steel Bracelet"
                  class="rt-stage-img"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {%- elsif main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 1200 }}"
                  alt="Casio Steel Links"
                  class="rt-stage-img rt-img-angle"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {%- else -%}
                <img
                  src="https://images.unsplash.com/photo-1542496658-e33a6d0d50f6?auto=format&fit=crop&w=1200&q=80"
                  alt="Casio Steel Links"
                  class="rt-stage-img"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {%- endif -%}
            </div>
            <div class="rt-slide-caption">VIEW 03 // 316L STEEL BRACELET</div>
          </div>

          <!-- Slide 3: Cyan EL Backlight Night Glow View -->
          <div class="rt-slide-panel rt-slide-night" data-slide="3">
            <div class="rt-img-frame rt-frame-glow">
              {%- if product.images.size > 3 -%}
                <img
                  src="{{ product.images[3] | image_url: width: 1200 }}"
                  alt="Casio EL Backlight Glow"
                  class="rt-stage-img"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {%- elsif main_img != blank -%}
                <img
                  src="{{ main_img | image_url: width: 1200 }}"
                  alt="Casio Night Glow"
                  class="rt-stage-img rt-img-night-glow"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {%- else -%}
                <img
                  src="https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?auto=format&fit=crop&w=1200&q=80"
                  alt="Casio Night Backlight"
                  class="rt-stage-img"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {%- endif -%}
              <div class="rt-el-glow-overlay"></div>
            </div>
            <div class="rt-slide-caption rt-caption-glow">VIEW 04 // EL ILLUMINATOR NIGHT GLOW</div>
          </div>
        </div>

        <!-- Carousel Navigation Arrows -->
        <button type="button" class="rt-nav-arrow rt-nav-prev" id="RtNavPrev" aria-label="Previous View">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="rt-nav-arrow rt-nav-next" id="RtNavNext" aria-label="Next View">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>

        <!-- Progress Indicator Dots -->
        <div class="rt-progress-dots" id="RtProgressDots">
          <button type="button" class="rt-dot-bar active" data-index="0" aria-label="View 1"></button>
          <button type="button" class="rt-dot-bar" data-index="1" aria-label="View 2"></button>
          <button type="button" class="rt-dot-bar" data-index="2" aria-label="View 3"></button>
          <button type="button" class="rt-dot-bar" data-index="3" aria-label="View 4"></button>
        </div>
      </div>

      <!-- Visible Visual Thumbnails Row with Image Previews -->
      <div class="rt-thumb-gallery" id="RtThumbGallery">
        <button type="button" class="rt-thumb-card active" data-slide-target="0">
          <div class="rt-thumb-preview">
            {%- if main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Dial">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=120&q=80" alt="Dial">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">Dial</span>
        </button>

        <button type="button" class="rt-thumb-card" data-slide-target="1">
          <div class="rt-thumb-preview">
            {%- if product.images.size > 1 -%}
              <img src="{{ product.images[1] | image_url: width: 140, height: 140, crop: 'center' }}" alt="Close Up">
            {%- elsif main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Close Up" style="transform: scale(1.4);">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=120&q=80" alt="Close Up">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">Close-Up</span>
        </button>

        <button type="button" class="rt-thumb-card" data-slide-target="2">
          <div class="rt-thumb-preview">
            {%- if product.images.size > 2 -%}
              <img src="{{ product.images[2] | image_url: width: 140, height: 140, crop: 'center' }}" alt="Steel">
            {%- elsif main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Steel" style="transform: rotate(20deg);">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1542496658-e33a6d0d50f6?auto=format&fit=crop&w=120&q=80" alt="Steel">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">Steel Band</span>
        </button>

        <button type="button" class="rt-thumb-card rt-thumb-card-glow" data-slide-target="3">
          <div class="rt-thumb-preview">
            {%- if product.images.size > 3 -%}
              <img src="{{ product.images[3] | image_url: width: 140, height: 140, crop: 'center' }}" alt="Night Glow">
            {%- elsif main_img != blank -%}
              <img src="{{ main_img | image_url: width: 140, height: 140, crop: 'center' }}" alt="Night Glow" style="filter: drop-shadow(0 0 8px #00f0ff);">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?auto=format&fit=crop&w=120&q=80" alt="Night Glow">
            {%- endif -%}
          </div>
          <span class="rt-thumb-title">EL Glow 💡</span>
        </button>
      </div>

      <!-- Quick Backlight Glow Simulator Pill -->
      <button type="button" class="rt-glow-simulator-btn" id="RtGlowSimulatorBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>Click to test EL Night Backlight</span>
      </button>
    </div>

    <!-- Info / Conversion Engine Side -->
    <div class="rt-info">
      <!-- Live Inventory & Dispatch Status (Human & Authentic) -->
      <div class="rt-stock-alert">
        <span class="rt-pulse-live"></span>
        <span>IN STOCK • DISPATCHES WITHIN 24 HOURS FROM MUMBAI</span>
      </div>

      <div class="rt-product-header">
        <span class="rt-category-tag">CASIO ARCHIVE SERIES • 1980s UNISEX ICON</span>
        <h1 class="rt-product-title">
          {{ section.settings.title | default: product.title | default: "Casio Vintage A168W Stainless Steel Watch" }}
        </h1>
        <p class="rt-product-subtitle">
          {{ section.settings.subtitle | default: "The definitive 1980s Japanese classic that never went out of style. Built in durable chrome-plated steel with Casio’s original cyan ElectroLuminescence backlight, daily alarm, stopwatch, and a bulletproof 7-year battery." }}
        </p>
      </div>

      <!-- Human Social Proof Rating with Buyer Avatars -->
      <div class="rt-rating-row">
        <div class="rt-avatar-stack">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=72&h=72&q=80" alt="Verified Buyer" class="rt-avatar-img" width="28" height="28" loading="lazy">
          <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=72&h=72&q=80" alt="Verified Buyer" class="rt-avatar-img" width="28" height="28" loading="lazy">
          <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=72&h=72&q=80" alt="Verified Buyer" class="rt-avatar-img" width="28" height="28" loading="lazy">
          <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=72&h=72&q=80" alt="Verified Buyer" class="rt-avatar-img" width="28" height="28" loading="lazy">
        </div>
        <div class="rt-rating-details">
          <div class="rt-stars">★★★★★</div>
          <span class="rt-rating-score">4.9 / 5.0</span>
          <span class="rt-review-count">• 1,480+ happy buyers across India</span>
        </div>
      </div>

      <!-- Classy, High-Trust Price Box (No Fake Progress Bars) -->
      <div class="rt-price-box">
        <div class="rt-price-row">
          <div class="rt-price-main">
            <span class="rt-currency">₹</span><span class="rt-amount">999</span>
          </div>
          <div class="rt-price-compare">
            <span class="rt-mrp-label">M.R.P.</span>
            <span class="rt-cut-price">₹1,999</span>
            <span class="rt-discount-pill">50% OFF</span>
          </div>
        </div>

        <!-- Human Delivery Reassurance Banner (Replacing Spammy Progress Bar) -->
        <div class="rt-delivery-promise-card">
          <div class="rt-promise-icon">🚚</div>
          <div class="rt-promise-text">
            <strong>Free Express Doorstep Delivery Across India</strong>
            <span>Order now & receive in 2–4 business days via BlueDart / Delhivery</span>
          </div>
        </div>

        <div class="rt-deal-perks">
          <span>✓ Free Express Shipping</span>
          <span>•</span>
          <span>✓ Cash on Delivery (COD)</span>
          <span>•</span>
          <span>✓ 30-Day Hassle-Free Returns</span>
          <span>•</span>
          <span>✓ All Taxes Included</span>
        </div>
      </div>

      <!-- Purchase Actions with Two-Line Primary Button -->
      {%- if product != blank -%}
        {%- form 'product', product, id: 'RtProductForm' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="RtVariantId">
          <input type="hidden" name="quantity" value="1">

          <div class="rt-actions-wrap">
            <button type="submit" class="rt-btn-buy-now" name="add" data-buy-now="true">
              <div class="rt-btn-content">
                <span class="rt-btn-main-text">ORDER NOW — CASH ON DELIVERY</span>
                <span class="rt-btn-sub-text">Pay ₹999 only when your parcel arrives</span>
              </div>
            </button>
            <button type="submit" class="rt-btn-add-cart" name="add">
              <span>Add to Cart</span>
            </button>
          </div>
        {%- endform -%}
      {%- else -%}
        <div class="rt-actions-wrap">
          <a href="/cart" class="rt-btn-buy-now">
            <div class="rt-btn-content">
              <span class="rt-btn-main-text">ORDER NOW — CASH ON DELIVERY</span>
              <span class="rt-btn-sub-text">Pay ₹999 only when your parcel arrives</span>
            </div>
          </a>
          <a href="/cart" class="rt-btn-add-cart">
            <span>Add to Cart</span>
          </a>
        </div>
      {%- endif -%}

      <!-- Human Frictionless Doorstep Inspection Note -->
      <div class="rt-zero-risk-note">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        <span><strong>100% Risk-Free:</strong> Open & inspect your watch at your doorstep before paying</span>
      </div>

      <!-- Technical Feature Highlights Strip (Directly Below Add to Cart) -->
      <div class="rt-trust-mini-grid">
        <div class="rt-trust-chip">
          <span class="rt-chip-icon">🛡️</span>
          <div class="rt-chip-label">
            <span>100% Genuine</span>
            <span>Casio</span>
          </div>
        </div>
        <div class="rt-trust-chip">
          <span class="rt-chip-icon">⚙️</span>
          <div class="rt-chip-label">
            <span>Japanese</span>
            <span>Quartz</span>
          </div>
        </div>
        <div class="rt-trust-chip">
          <span class="rt-chip-icon">💧</span>
          <div class="rt-chip-label">
            <span>30M Water</span>
            <span>Resistant</span>
          </div>
        </div>
        <div class="rt-trust-chip">
          <span class="rt-chip-icon">🔋</span>
          <div class="rt-chip-label">
            <span>7-Year</span>
            <span>Battery Life</span>
          </div>
        </div>
      </div>

      <!-- Trust & Guarantees (Restored) -->
      <div class="rt-guarantees-grid">
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>
          <div>
            <div class="rt-guarantee-title">Dispatches Under 24 Hours</div>
            <div class="rt-guarantee-sub">Fast track via BlueDart / Delhivery</div>
          </div>
        </div>
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
          <div>
            <div class="rt-guarantee-title">Free Express Shipping</div>
            <div class="rt-guarantee-sub">Tracked delivery across India</div>
          </div>
        </div>
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <div>
            <div class="rt-guarantee-title">30-Day Hassle-Free Returns</div>
            <div class="rt-guarantee-sub">100% money back or replacement</div>
          </div>
        </div>
        <div class="rt-guarantee-item">
          <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
          <div>
            <div class="rt-guarantee-title">Cash On Delivery (COD)</div>
            <div class="rt-guarantee-sub">Pay safely at doorstep</div>
          </div>
        </div>
      </div>

      <!-- Human Boutique Curator Promise Note -->
      <div class="rt-curator-note">
        <div class="rt-curator-header">
          <span class="rt-curator-badge">✦ RETROTICK AUTHENTICITY PROMISE</span>
        </div>
        <p>“We don’t deal in counterfeit or refurbished watches. Every Casio piece is brand new, individually inspected for quartz precision in Mumbai, and packed directly in its authentic Casio packaging with stamped documentation.”</p>
      </div>
    </div>
  </div>
</section>

<!-- Rock-Solid 5-Second Carousel & Glow Simulator JavaScript -->
<script>
  (function() {
    function initGallery() {
      var slides = document.querySelectorAll('#RtSlidesViewport .rt-slide-panel');
      var dots = document.querySelectorAll('#RtProgressDots .rt-dot-bar');
      var thumbs = document.querySelectorAll('#RtThumbGallery .rt-thumb-card');
      var prevBtn = document.getElementById('RtNavPrev');
      var nextBtn = document.getElementById('RtNavNext');
      var glowBtn = document.getElementById('RtGlowSimulatorBtn');
      var wrapper = document.getElementById('RtGalleryWrapper');

      if (!slides.length) return;

      var currentSlide = 0;
      var totalSlides = slides.length;
      var slideInterval = null;
      var intervalDuration = 5000; // 5 seconds

      function showSlide(index) {
        currentSlide = (index + totalSlides) % totalSlides;

        slides.forEach(function(s, i) {
          s.classList.toggle('active', i === currentSlide);
        });

        dots.forEach(function(d, i) {
          d.classList.toggle('active', i === currentSlide);
        });

        thumbs.forEach(function(t, i) {
          t.classList.toggle('active', i === currentSlide);
        });
      }

      function next() {
        showSlide(currentSlide + 1);
      }

      function prev() {
        showSlide(currentSlide - 1);
      }

      function startAutoPlay() {
        stopAutoPlay();
        slideInterval = setInterval(next, intervalDuration);
      }

      function stopAutoPlay() {
        if (slideInterval) {
          clearInterval(slideInterval);
          slideInterval = null;
        }
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          next();
          startAutoPlay();
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          prev();
          startAutoPlay();
        });
      }

      thumbs.forEach(function(thumb) {
        thumb.addEventListener('click', function(e) {
          e.preventDefault();
          var target = parseInt(this.getAttribute('data-slide-target'), 10);
          showSlide(target);
          startAutoPlay();
        });
      });

      dots.forEach(function(dot) {
        dot.addEventListener('click', function(e) {
          e.preventDefault();
          var target = parseInt(this.getAttribute('data-index'), 10);
          showSlide(target);
          startAutoPlay();
        });
      });

      // Quick Night Glow Simulator Button
      if (glowBtn) {
        glowBtn.addEventListener('click', function(e) {
          e.preventDefault();
          showSlide(3); // Slide 3 is the Cyan Night Glow
          startAutoPlay();
        });
      }

      // Pause on hover
      if (wrapper) {
        wrapper.addEventListener('mouseenter', stopAutoPlay);
        wrapper.addEventListener('mouseleave', startAutoPlay);
      }

      // Start automatic movement
      startAutoPlay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGallery);
    } else {
      initGallery();
    }
  })();
</script>

{% schema %}
{
  "name": "Retrotick Single Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Select Product"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Custom Title Override",
      "default": "Casio Vintage Unisex Stainless Steel Watch"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The definitive 1980s retro icon. Engineered in surgical-grade stainless steel with 30M water-resistance, 7-year battery, and signature cyan ElectroLuminescence backlight."
    }
  ],
  "presets": [
    {
      "name": "Retrotick Single Product"
    }
  ]
}
{% endschema %}
