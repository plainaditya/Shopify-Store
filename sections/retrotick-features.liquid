<section class="rt-features-section" id="Features">
  <div class="rt-section-header">
    <span class="rt-section-badge">ENGINEERING & CRAFTSMANSHIP</span>
    <h2 class="rt-section-title">Anatomy of a Vintage Icon</h2>
    <p class="rt-section-sub">
      Designed in Tokyo, celebrated worldwide. Every contour, link, and pixel has been refined for 40+ years of uninterrupted prestige.
    </p>
  </div>

  <div class="rt-features-grid">
    <div class="rt-feature-card">
      <span class="rt-feature-number">01 // CASING</span>
      <div class="rt-feature-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 14 14"></polyline>
        </svg>
      </div>
      <h3 class="rt-feature-title">Ultra-Slim 9.6mm Profile</h3>
      <p class="rt-feature-desc">
        Engineered with a lightweight 49-gram profile that slides effortlessly under formal cuffs or stands out with streetwear.
      </p>
    </div>

    <div class="rt-feature-card">
      <span class="rt-feature-number">02 // ILLUMINATION</span>
      <div class="rt-feature-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
      </div>
      <h3 class="rt-feature-title">EL Blue-Green Night Glow</h3>
      <p class="rt-feature-desc">
        Signature ElectroLuminescence panel casts an even, brilliant cyan glow across the entire display at the press of a side button.
      </p>
    </div>

    <div class="rt-feature-card">
      <span class="rt-feature-number">03 // BRACELET</span>
      <div class="rt-feature-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="7" width="20" height="10" rx="2"></rect>
          <line x1="7" y1="7" x2="7" y2="17"></line>
          <line x1="17" y1="7" x2="17" y2="17"></line>
        </svg>
      </div>
      <h3 class="rt-feature-title">Brushed Stainless Steel</h3>
      <p class="rt-feature-desc">
        Corrosion-resistant steel link bracelet with an intuitive self-adjusting sliding clasp. Fits all wrist sizes with zero tools needed.
      </p>
    </div>

    <div class="rt-feature-card">
      <span class="rt-feature-number">04 // MODULE</span>
      <div class="rt-feature-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <h3 class="rt-feature-title">1/100-Sec Stopwatch & Alarm</h3>
      <p class="rt-feature-desc">
        Precision digital quartz tracking with split-second timing, hourly time chimes, acoustic daily alarms, and perpetual auto-calendar.
      </p>
    </div>

    <div class="rt-feature-card">
      <span class="rt-feature-number">05 // RESILIENCE</span>
      <div class="rt-feature-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
        </svg>
      </div>
      <h3 class="rt-feature-title">30-Meter Water Resistance</h3>
      <p class="rt-feature-desc">
        Water-sealed against daily monsoon rains, hand washing, splashes, and everyday humidity. Built for real-world life.
      </p>
    </div>

    <div class="rt-feature-card">
      <span class="rt-feature-number">06 // ENDURANCE</span>
      <div class="rt-feature-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="7" width="16" height="10" rx="2" ry="2"></rect>
          <line x1="22" y1="11" x2="22" y2="13"></line>
        </svg>
      </div>
      <h3 class="rt-feature-title">7-Year Long-Life Battery</h3>
      <p class="rt-feature-desc">
        Powered by an ultra-efficient Japanese low-power microcircuit on a single CR2016 cell. Set it, wear it, forget about charging forever.
      </p>
    </div>
  </div>
</section>

